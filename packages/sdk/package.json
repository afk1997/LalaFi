{
  "name": "@xpool/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "xpool v1 SDK: keys, crypto, notes, tree, sync, prover, tx, relayer, privacy, chains",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fixtures": "tsx scripts/gen-fixtures.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.6",
    "socks-proxy-agent": "^10.1.0",
    "tweetnacl": "^1.0.3",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "circomlibjs": "^0.1.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
